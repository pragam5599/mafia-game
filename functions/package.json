{
  "name": "mafia-functions",
  "private": true,
  "description": "Game server. Runs on the Firebase emulators locally and on Vercel (free) live. The server decides: names, rooms, roles, night, votes, wins.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "build": "npm run sync-engine && tsc",
    "build:watch": "npm run sync-engine && tsc --watch"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
